# FutureMe AI — optional server-side Anthropic configuration
#
# The demo runs without these variables. Route selection remains deterministic
# and executes in the browser. When no key is set, /api/explain and /api/chat
# use their deterministic offline fallbacks.

# Optional and server-side only. Never expose this value through NEXT_PUBLIC_*.
# When configured, /api/explain may reword fixed route reasons and /api/chat may
# send the bounded chat transcript to Anthropic.
# Do not expose a funded key on a public deployment until authentication or
# rate limiting, spend caps, and host/provider retention terms are in place.
ANTHROPIC_API_KEY=

# Optional. Used by both endpoints when ANTHROPIC_API_KEY is present.
ANTHROPIC_MODEL=claude-sonnet-5
